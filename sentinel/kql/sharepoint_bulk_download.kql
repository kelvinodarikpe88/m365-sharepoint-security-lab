// SharePoint bulk download detection
// Review large volumes of SharePoint file access/download activity.

OfficeActivity
| where TimeGenerated >= ago(24h)
| where Workload =~ "SharePoint"
| where Operation has_any ("FileDownloaded", "FileSyncDownloadedFull")
| summarize
    DownloadCount = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by UserId, ClientIP
| where DownloadCount >= 50
| order by DownloadCount desc
